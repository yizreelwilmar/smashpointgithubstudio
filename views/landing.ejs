<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= settings.community_name %> — Komunitas Badminton & Mabar Terorganisir</title>
  <meta name="description" content="<%= settings.description %>">
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            court: {
              DEFAULT: '#059669',
              dark: '#064e3b',
              light: '#10b981',
              accent: '#f59e0b'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased min-h-screen flex flex-col">

  <!-- TOP NAVIGATION PILL BAR (Applet Switcher) -->
  <header class="sticky top-0 z-50 bg-slate-950/90 backdrop-blur border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center font-black text-xl shadow-lg shadow-emerald-900/40 text-white">
          🏸
        </div>
        <div>
          <span class="font-extrabold text-base tracking-tight text-white block"><%= settings.community_name %></span>
          <span class="text-xs text-emerald-400 font-medium">Jakarta Selatan • Est. <%= settings.established_year %></span>
        </div>
      </div>

      <!-- Quick Switcher Pills -->
      <nav class="flex items-center space-x-1.5 bg-slate-900 p-1.5 rounded-full border border-slate-800 shadow-inner">
        <a href="/" class="px-4 py-1.5 rounded-full text-xs font-bold transition bg-emerald-500 text-slate-950 shadow">
          🏠 Landing
        </a>
        <a href="/app" class="px-4 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition">
          📱 App Operasional
        </a>
        <a href="/admin" class="px-4 py-1.5 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition">
          ⚙️ CMS Admin
        </a>
      </nav>

      <div class="hidden md:flex items-center space-x-3">
        <a href="#schedules" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-4 py-2 rounded-xl transition shadow-lg shadow-emerald-900/30 flex items-center gap-1.5">
          <i data-lucide="calendar" class="w-4 h-4"></i>
          <span>Jadwal Mabar</span>
        </a>
      </div>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section class="relative py-16 lg:py-24 overflow-hidden border-b border-slate-800 bg-gradient-to-b from-slate-950 to-slate-900">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:24px_24px]"></div>
    <div class="max-w-5xl mx-auto px-4 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-800/60 text-emerald-300 text-xs font-semibold mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span><%= settings.announcement_text %></span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight mb-6">
        Main Bareng Teratur, <br>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-amber-300">
          Rotasi Lapangan Adil & Akurat
        </span>
      </h1>
      
      <p class="text-base sm:text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed mb-8">
        <%= settings.hero_subtitle %>
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        <a href="#schedules" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-6 py-3.5 rounded-xl shadow-lg shadow-emerald-500/20 transition flex items-center gap-2 text-sm">
          <span>Pilih Jadwal & Daftar</span>
          <i data-lucide="arrow-down" class="w-4 h-4"></i>
        </a>
        <a href="/app" class="bg-slate-800 hover:bg-slate-700 text-white font-semibold px-6 py-3.5 rounded-xl border border-slate-700 transition flex items-center gap-2 text-sm">
          <i data-lucide="smartphone" class="w-4 h-4 text-emerald-400"></i>
          <span>Buka Courtside App</span>
        </a>
      </div>

      <!-- Quick Metrics -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-14 max-w-4xl mx-auto">
        <div class="bg-slate-800/60 border border-slate-800 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400"><%= schedules.length %> Sesi</div>
          <div class="text-xs text-slate-400 mt-1">Multi-Cabang / Minggu</div>
        </div>
        <div class="bg-slate-800/60 border border-slate-800 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-extrabold text-white"><%= players.length %>+</div>
          <div class="text-xs text-slate-400 mt-1">Member Terdaftar</div>
        </div>
        <div class="bg-slate-800/60 border border-slate-800 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-extrabold text-amber-400">Fair Social</div>
          <div class="text-xs text-slate-400 mt-1">Algoritma Rotasi Ganda</div>
        </div>
        <div class="bg-slate-800/60 border border-slate-800 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-extrabold text-teal-400">100% Cashless</div>
          <div class="text-xs text-slate-400 mt-1">Rekap Iuran Real-Time</div>
        </div>
      </div>
    </div>
  </section>

  <!-- JADWAL MABAR SECTION -->
  <section id="schedules" class="py-16 bg-slate-900 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-xs font-bold text-emerald-400 tracking-wider uppercase">JADWAL MINGGUAN MULTI-CABANG</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Pilih Sesi Mabar Kamu</h2>
          <p class="text-slate-400 text-sm mt-1">Powershoot aktif 3-4x seminggu di berbagai GOR pilihan Jakarta.</p>
        </div>
        <div class="text-xs text-slate-400 bg-slate-800 px-3.5 py-2 rounded-xl border border-slate-700 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Shuttlecock Bulu Angsa resmi disediakan panitia</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% schedules.forEach(s => { %>
          <div class="bg-slate-800/80 border border-slate-700 rounded-2xl p-6 flex flex-col justify-between hover:border-emerald-500/50 transition shadow-lg group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 rounded-full text-xs font-bold <%= s.status === 'in_progress' ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' %>">
                  <%= s.day_name %>
                </span>
                <span class="text-xs font-bold text-slate-400">
                  <%= s.court_count %> Lapangan
                </span>
              </div>

              <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition leading-snug mb-2">
                <%= s.title %>
              </h3>

              <div class="space-y-2 text-xs text-slate-300 my-4">
                <div class="flex items-start gap-2">
                  <i data-lucide="map-pin" class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5"></i>
                  <div>
                    <span class="font-semibold text-white block"><%= s.venue_name %></span>
                    <span class="text-slate-400"><%= s.venue_address || s.branch_area %></span>
                    <% if (s.venue_maps_url) { %>
                      <a href="<%= s.venue_maps_url %>" target="_blank" class="text-emerald-400 hover:underline block mt-0.5">Buka Google Maps →</a>
                    <% } %>
                  </div>
                </div>

                <div class="flex items-center gap-2">
                  <i data-lucide="clock" class="w-4 h-4 text-emerald-400 shrink-0"></i>
                  <span><%= s.time_start %> - <%= s.time_end %> WIB</span>
                </div>

                <div class="flex items-center gap-2">
                  <i data-lucide="user-check" class="w-4 h-4 text-emerald-400 shrink-0"></i>
                  <span>PIC: <strong class="text-white"><%= s.pic_name %></strong></span>
                </div>

                <div class="flex items-center gap-2">
                  <i data-lucide="users" class="w-4 h-4 text-emerald-400 shrink-0"></i>
                  <span>Maksimal: <strong class="text-white"><%= s.max_slots %> Peserta</strong></span>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-700/80 mt-2 flex items-center justify-between gap-3">
              <div>
                <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Iuran Mabar</span>
                <span class="text-lg font-black text-emerald-400">Rp <%= Number(s.fee_per_person).toLocaleString('id-ID') %></span>
              </div>

              <div class="flex gap-2">
                <a href="/app?session_id=<%= s.id %>" class="bg-slate-700 hover:bg-slate-600 text-white font-bold text-xs px-3 py-2.5 rounded-xl transition">
                  Papan Lapangan
                </a>
                <a href="https://wa.me/<%= String(s.pic_whatsapp).replace(/^0/, '62') %>?text=Halo%20<%= encodeURIComponent(s.pic_name) %>%2C%20saya%20ingin%20daftar%20mabar%20<%= encodeURIComponent(s.title) %>" target="_blank" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs px-3.5 py-2.5 rounded-xl transition flex items-center gap-1.5 shadow">
                  <i data-lucide="message-circle" class="w-3.5 h-3.5"></i>
                  <span>Daftar WA</span>
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- TOP LEADERBOARD PREVIEW -->
  <section class="py-16 bg-slate-950 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
          <span class="text-xs font-bold text-amber-400 tracking-wider uppercase">HALL OF FAME KOMUNITAS</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Top Poin Leaderboard</h2>
          <p class="text-slate-400 text-sm mt-1">Akumulasi seluruh poin yang dicetak di setiap pertandingan. Setiap reli sangat berharga!</p>
        </div>
        <a href="/app?view=leaderboard" class="text-xs font-bold text-emerald-400 hover:text-emerald-300 flex items-center gap-1">
          <span>Lihat Leaderboard Lengkap</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-800/80 text-xs font-bold text-slate-300 uppercase tracking-wider border-b border-slate-800">
              <tr>
                <th class="py-3.5 px-4 w-16 text-center">Rank</th>
                <th class="py-3.5 px-4">Pemain</th>
                <th class="py-3.5 px-4">Level</th>
                <th class="py-3.5 px-4 text-center">Main</th>
                <th class="py-3.5 px-4 text-center">W / L</th>
                <th class="py-3.5 px-4 text-center">Win Rate</th>
                <th class="py-3.5 px-4 text-right">Total Poin</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 font-medium">
              <% leaderboard.slice(0, 7).forEach((p, index) => { %>
                <tr class="hover:bg-slate-800/40 transition <%= index === 0 ? 'bg-amber-950/20' : '' %>">
                  <td class="py-3 px-4 text-center">
                    <% if (index === 0) { %>
                      <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-amber-400 text-slate-950 font-black text-xs">🥇 1</span>
                    <% } else if (index === 1) { %>
                      <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-slate-300 text-slate-950 font-black text-xs">🥈 2</span>
                    <% } else if (index === 2) { %>
                      <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-amber-700 text-white font-black text-xs">🥉 3</span>
                    <% } else { %>
                      <span class="text-slate-400 font-bold text-xs">#<%= index + 1 %></span>
                    <% } %>
                  </td>
                  <td class="py-3 px-4">
                    <span class="text-white font-bold block"><%= p.name %></span>
                  </td>
                  <td class="py-3 px-4">
                    <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold <%= p.level === 'Advance' ? 'bg-purple-900/40 text-purple-300 border border-purple-700/50' : p.level === 'Intermediate' ? 'bg-blue-900/40 text-blue-300 border border-blue-700/50' : 'bg-emerald-900/40 text-emerald-300 border border-emerald-700/50' %>">
                      <%= p.level %>
                    </span>
                  </td>
                  <td class="py-3 px-4 text-center text-slate-300"><%= p.total_matches %></td>
                  <td class="py-3 px-4 text-center">
                    <span class="text-emerald-400 font-bold"><%= p.wins %></span> / <span class="text-rose-400 font-bold"><%= p.losses %></span>
                  </td>
                  <td class="py-3 px-4 text-center">
                    <div class="flex items-center justify-center gap-1.5">
                      <div class="w-16 bg-slate-800 h-2 rounded-full overflow-hidden">
                        <div class="bg-emerald-500 h-full rounded-full" style="width: <%= p.win_rate %>%"></div>
                      </div>
                      <span class="text-xs text-slate-300 font-bold"><%= p.win_rate %>%</span>
                    </div>
                  </td>
                  <td class="py-3 px-4 text-right">
                    <span class="text-base font-black text-amber-400"><%= Number(p.total_points).toLocaleString('id-ID') %></span>
                    <span class="text-xs text-slate-400 block font-normal">pts</span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- GALLERY & DOKUMENTASI -->
  <section class="py-16 bg-slate-900 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold text-emerald-400 tracking-wider uppercase">DOKUMENTASI MABAR</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Suasana Lapangan & Kebersamaan</h2>
        <p class="text-slate-400 text-sm mt-1">Bukan sekadar olahraga, ini ajang silaturahmi sehat badminton lovers.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <% gallery.forEach(g => { %>
          <div class="group relative rounded-2xl overflow-hidden bg-slate-800 aspect-video sm:aspect-square shadow-lg">
            <img src="<%= g.image_url %>" alt="<%= g.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent p-4 flex flex-col justify-end">
              <span class="text-xs font-bold text-white leading-tight"><%= g.title %></span>
              <span class="text-[11px] text-slate-300 mt-0.5"><%= g.caption %></span>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ARTIKEL & TATA TERTIB -->
  <section class="py-16 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="text-xs font-bold text-emerald-400 tracking-wider uppercase">INFORMASI KOMUNITAS</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Tata Tertib & Artikel Mabar</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% articles.forEach(art => { %>
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between">
            <div>
              <span class="px-2.5 py-1 rounded text-[11px] font-bold bg-slate-800 text-emerald-400 border border-slate-700">
                <%= art.category %>
              </span>
              <h3 class="text-lg font-bold text-white mt-3 mb-2"><%= art.title %></h3>
              <p class="text-sm text-slate-300 leading-relaxed mb-4"><%= art.excerpt %></p>
            </div>
            <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-400">📅 <%= art.created_at %></span>
              <a href="/article/<%= art.slug %>" class="text-xs font-bold text-emerald-400 hover:text-emerald-300 flex items-center gap-1">
                <span>Baca Aturan</span>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="mt-auto bg-slate-950 border-t border-slate-800 py-10 text-xs text-slate-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center space-x-2">
        <span class="font-extrabold text-white text-sm"><%= settings.community_name %></span>
        <span>— Komunitas Badminton Modern & Cashless</span>
      </div>
      <div class="flex items-center space-x-4">
        <a href="/" class="hover:text-white">Landing</a>
        <a href="/app" class="hover:text-white">Aplikasi Lapangan</a>
        <a href="/admin" class="hover:text-white">CMS Admin</a>
        <a href="https://instagram.com" target="_blank" class="hover:text-white"><%= settings.instagram %></a>
      </div>
    </div>
  </footer>

  <script>
    lucide.createIcons();
  </script>
</body>
</html>
